<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="VK_UI3.Views.Notification.TwitchNotifController"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Grid
		Padding="10"
		ColumnSpacing="10"
		RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Шапка: красный кружочек + имя стримера -->
		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal"
			Spacing="8">
			<TextBlock
				x:Name="LiveDot"
				FontSize="18"
				Text="🔴"
				VerticalAlignment="Center" />
			<TextBlock
				x:Name="NameText"
				VerticalAlignment="Center"
				FontSize="20"
				FontWeight="SemiBold"
				TextWrapping="Wrap" />
		</StackPanel>

		<!-- Название стрима -->
		<TextBlock
			x:Name="TitleText"
			Grid.Row="1"
			FontSize="14"
			Opacity="0.9"
			TextWrapping="Wrap"
			Visibility="Collapsed" />

		<!-- Игра -->
		<TextBlock
			x:Name="GameText"
			Grid.Row="2"
			FontSize="13"
			Opacity="0.7"
			TextWrapping="Wrap"
			Visibility="Collapsed" />

		<!-- Зрители -->
		<StackPanel
			Grid.Row="3"
			Orientation="Horizontal"
			Spacing="6">
			<FontIcon
				FontFamily="Segoe Fluent Icons"
				FontSize="14"
				Glyph="&#xE707;"
				VerticalAlignment="Center" />
			<TextBlock
				x:Name="ViewersText"
				VerticalAlignment="Center"
				FontSize="14"
				TextWrapping="Wrap" />
		</StackPanel>

		<!-- Кнопка "Зайти на стрим" -->
		<Button
			x:Name="OpenStreamButton"
			Grid.Row="4"
			HorizontalAlignment="Stretch"
			Content="Зайти на стрим"
			Click="OpenStreamButton_Click" />
	</Grid>
</UserControl>