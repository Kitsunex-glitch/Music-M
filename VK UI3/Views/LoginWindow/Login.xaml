<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VK_UI3.Views.LoginWindow.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VK_UI3.Views.LoginWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootGrid"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    mc:Ignorable="d">
    <Page.Resources>
        <ThemeShadow x:Name="SharedShadow" />
    </Page.Resources>

    <Grid
        Margin="50"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
        CornerRadius="8"
        Translation="0,0,8">
        <Grid.Shadow>
            <ThemeShadow />
        </Grid.Shadow>

        <ScrollView>

            <StackPanel
                Margin="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Translation="0,0,8">

                <Viewbox Width="100" Height="100">
                    <Image AutomationProperties.Name="Логотип приложения" Source="ms-appx:///Assets/StoreLogo.scale-400.png" />
                </Viewbox>
                <TextBlock
                    Margin="0,0,0,10"
                    AutomationProperties.Name="Введите Логин"
                    Text="Введите Логин" />

                <Grid
                    Margin="0,0,0,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="LoginTextBox"
                        Grid.Column="0"
                        MinWidth="300"
                        AutomationProperties.Name="Поле ввода логина"
                        KeyDown="LoginTextBox_KeyDown" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Помощь по логину">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <TextBlock
                                    Width="250"
                                    Text="Логином может являться ваш номер телефона или электронная почта, на которую зарегистрирован ваш аккаунт ВКонтакте (VK)."
                                    TextWrapping="Wrap" />
                            </Flyout>
                        </Button.Flyout>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="?" />
                    </Button>
                </Grid>
                <TextBlock
                    x:Name="errorTextBlock"
                    Width="300"
                    Foreground="Red"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />


                <Button
                    x:Name="LoginButton"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Кнопка входа"
                    Click="LoginButton_Click"
                    Content="Войти"
                    Style="{StaticResource AccentButtonStyle}" />

                <!--
                    Вход по готовому access_token: без логина, пароля и 2FA.
                    Токен вводится в отдельной всплывающей панели, чтобы форма
                    не разрасталась и поле не путалось с полем логина.
                -->
                <Button
                    x:Name="TokenLoginButton"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.HelpText="Вход без логина и пароля — по готовому access_token VK"
                    AutomationProperties.Name="Войти по токену"
                    Content="Войти по токену">
                    <Button.Flyout>
                        <Flyout Placement="Bottom" Opening="TokenFlyout_Opening">
                            <StackPanel
                                Width="360"
                                Spacing="10"
                                Padding="4">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Вход по access_token" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Вставьте access_token VK с правами audio. Токен хранится только на этом устройстве."
                                    TextWrapping="Wrap" />
                                <!--
                                    PasswordBox, а не TextBox: токен не должен отображаться
                                    на экране (нет свойства PasswordRevealMode у TextBox).
                                -->
                                <PasswordBox
                                    x:Name="TokenTextBox"
                                    AutomationProperties.Name="Поле ввода токена"
                                    Height="40"
                                    PlaceholderText="vk1.a..." />
                                <TextBlock
                                    x:Name="TokenErrorTextBlock"
                                    Foreground="Red"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="Collapsed" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Click="TokenLoginButton_Click"
                                        Content="Войти"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Click="TokenCancelButton_Click"
                                        Content="Отмена" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="BackBTN"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Кнопка отмены"
                    Click="BackButton"
                    Content="Отмена" />
                <TextBlock Margin="0,20,0,0" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://t.me/music_m_rework">Music M в telegram</Hyperlink>
                </TextBlock>

            </StackPanel>
        </ScrollView>
    </Grid>


</Page>
