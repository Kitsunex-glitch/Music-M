<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VK_UI3.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:VK_UI3.Helpers.Animations"
    xmlns:controlLyryc="using:VK_UI3.Views.ModalsPages"
    xmlns:custom="using:VK_UI3.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:krotos="using:KrotosNavigationFrame"
    xmlns:local="using:VK_UI3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.HelpText="Основная страница приложения с навигацией и плеером"
    AutomationProperties.Name="Главная страница приложения"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Page.Resources>
        <ThemeShadow x:Name="SharedShadow" />

        <Storyboard x:Name="ExpandAnimation">
            <DoubleAnimation
                EnableDependentAnimation="True"
                Storyboard.TargetName="LyricPage"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Name="CollapseAnimation">
            <DoubleAnimation
                EnableDependentAnimation="True"
                Storyboard.TargetName="LyricPage"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.3" />
        </Storyboard>


        <Storyboard x:Name="ExpandAnimationPlayingList">
            <DoubleAnimation
                EnableDependentAnimation="True"
                Storyboard.TargetName="SectionViewPageNowPlayingList"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Name="CollapseAnimationPlayingList">
            <DoubleAnimation
                EnableDependentAnimation="True"
                Storyboard.TargetName="SectionViewPageNowPlayingList"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.3" />
        </Storyboard>

    </Page.Resources>


    <Grid AutomationProperties.HelpText="Основная область компоновки приложения" AutomationProperties.Name="Основная сетка приложения">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.HelpText="Основная область навигации приложения"
            AutomationProperties.Name="Область навигации">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>

            <NavigationView
                Name="NavWiv"
                Grid.RowSpan="2"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AutomationProperties.HelpText="Основное меню навигации приложения"
                AutomationProperties.Name="Навигационное меню"
                IsBackButtonVisible="Collapsed"
                IsBackEnabled="False"
                IsPaneOpen="False"
                IsSettingsVisible="True"
                ItemInvoked="NavWiv_ItemInvoked"
                PaneDisplayMode="Auto">

                <NavigationView.MenuItems>
                    <NavigationViewItem
                        AutomationProperties.HelpText="Перейти к моей музыке"
                        AutomationProperties.Name="Моя музыка"
                        Content="Моя музыка">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                AutomationProperties.HelpText="Иконка раздела музыки"
                                AutomationProperties.Name="Иконка музыки"
                                Glyph="&#xEC4F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>


                    <NavigationViewItem
                        AutomationProperties.HelpText="Перейти к моим плейлистам"
                        AutomationProperties.Name="Мои плейлисты"
                        Content="Мои плейлисты">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                AutomationProperties.HelpText="Иконка раздела плейлистов"
                                AutomationProperties.Name="Иконка плейлиста"
                                Glyph="&#xE93C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem
                        AutomationProperties.HelpText="Перейти к плейлистам"
                        AutomationProperties.Name="Плейлисты"
                        Content="Плейлисты">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                AutomationProperties.HelpText="Иконка раздела плейлистов"
                                AutomationProperties.Name="Иконка плейлиста"
                                Glyph="&#xEB51;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem
                        AutomationProperties.HelpText="Перейти к музыке друзей"
                        AutomationProperties.Name="Музыка друзей"
                        Content="Музыка друзей">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                AutomationProperties.HelpText="Иконка раздела друзей"
                                AutomationProperties.Name="Иконка друзей"
                                Glyph="&#xE716;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem
                        AutomationProperties.HelpText="Перейти к вложениям"
                        AutomationProperties.Name="Вложения"
                        Content="Вложения">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                AutomationProperties.HelpText="Иконка раздела вложений"
                                AutomationProperties.Name="Иконка вложений"
                                Glyph="&#xE8F2;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem
                        AutomationProperties.HelpText="Перейти к рекомендациям"
                        AutomationProperties.Name="Для Вас"
                        Content="Для Вас">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                AutomationProperties.HelpText="Иконка раздела рекомендаций"
                                AutomationProperties.Name="Иконка рекомендаций"
                                Glyph="&#xEC32;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator />
                    <NavigationViewItemHeader />

                </NavigationView.MenuItems>
                <Grid
                    x:Name="MainGridLir"
                    Margin="0"
                    AutomationProperties.HelpText="Основная область отображения содержимого приложения"
                    AutomationProperties.Name="Основная область содержимого"
                    PointerEntered="ListViewItem_PointerEntered">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <animations:AnimatedSearch
                        x:Name="Search"
                        Grid.Row="0"
                        Height="0"
                        Margin="0"
                        AutomationProperties.HelpText="Панель для поиска музыки и контента"
                        AutomationProperties.Name="Панель поиска"
                        OriginalHeight="50" />
                    <Grid
                        x:Name="TabsHost"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <TabView
                            x:Name="Tabs"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            AutomationProperties.HelpText="Вкладки с содержимым приложения. Ctrl+клик по пункту меню или карточке открывает новую вкладку"
                            AutomationProperties.Name="Вкладки"
                            CloseButtonOverlayMode="OnPointerOver"
                            IsAddTabButtonVisible="True"
                            SelectionChanged="Tabs_SelectionChanged"
                            TabCloseRequested="Tabs_TabCloseRequested"
                            TabWidthMode="SizeToContent">
                            <TabView.TabStripHeader>
                                <Grid Width="0" />
                            </TabView.TabStripHeader>
                        </TabView>
                        <Grid
                            x:Name="EmptyState"
                            Background="{ThemeResource SystemControlAltHighAcrylicElementBrush}"
                            Visibility="Collapsed">
                            <StackPanel
                                MaxWidth="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="36"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE7C4;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="Нет открытых вкладок" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Выберите раздел в меню слева, чтобы открыть его во вкладке."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Center"
                                    Click="OpenHomeTab_Click"
                                    Content="Моя музыка" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </NavigationView>
            <controlLyryc:LyricsPage
                x:Name="LyricPage"
                Grid.Row="3"
                VerticalAlignment="Stretch"
                AutomationProperties.HelpText="Отображает тексты песен для текущего трека"
                AutomationProperties.Name="Страница текстов песен"
                Background="{ThemeResource SystemControlAltHighAcrylicElementBrush}"
                Opacity="0"
                Visibility="Collapsed" />
            <controlLyryc:EqualizerControl
                x:Name="EqualizerControlPage"
                Grid.Row="3"
                VerticalAlignment="Stretch"
                AutomationProperties.HelpText="Настройка звуковых параметров воспроизведения"
                AutomationProperties.Name="Эквалайзер"
                Background="{ThemeResource SystemControlAltHighAcrylicElementBrush}"
                Opacity="0"
                Visibility="Collapsed" />
            <Frame
                x:Name="SectionViewPageNowPlayingList"
                Grid.Row="3"
                VerticalAlignment="Stretch"
                AutomationProperties.HelpText="Отображает список треков в текущем плейлисте"
                AutomationProperties.Name="Список воспроизведения"
                Background="{ThemeResource SystemControlAltHighAcrylicElementBrush}"
                Opacity="0"
                Visibility="Collapsed" />
        </Grid>
        <Frame
            Grid.Row="1"
            VerticalAlignment="Bottom"
            AutomationProperties.HelpText="Основной музыкальный плеер приложения"
            AutomationProperties.Name="Плеер"
            BorderThickness="0,1,0,0">
            <custom:AudioPlayer
                Margin="0,0,0,0"
                AutomationProperties.HelpText="Компонент управления воспроизведением музыки"
                AutomationProperties.Name="Аудио плеер" />
        </Frame>
    </Grid>
</Page>
