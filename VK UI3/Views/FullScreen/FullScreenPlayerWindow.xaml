<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="VK_UI3.Views.FullScreen.FullScreenPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VK_UI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fullscreen="using:VK_UI3.Views.FullScreen"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewsControls="using:VK_UI3.Views.Controls"
    xmlns:winui="using:WinUICommunity"
    Title="Полноэкранный плеер"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46*" />
            <ColumnDefinition Width="54*" />
        </Grid.ColumnDefinitions>

        <!--  Контекстное меню (правый клик), как у AudioControlFlyOut в AudioPlayer  -->
        <Grid.ContextFlyout>
            <controls:AudioControlFlyOut x:Name="FlyOutControl" />
        </Grid.ContextFlyout>

        <!--
            Фон окна: обложка на весь экран + затемнение.
            Маска по горизонтали: слева обложка видна полностью, к правой зоне
            плавно растворяется — правая панель «наплывает» на неё без жёсткой границы.
        -->
        <winui:OpacityMaskView Grid.ColumnSpan="2">
            <winui:OpacityMaskView.OpacityMask>
                <LinearGradientBrush MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                    <GradientStop Offset="0.38" Color="#FFFFFFFF" />
                    <GradientStop Offset="0.46" Color="#CCFFFFFF" />
                    <GradientStop Offset="0.56" Color="#66FFFFFF" />
                    <GradientStop Offset="0.66" Color="#00FFFFFF" />
                    <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
            </winui:OpacityMaskView.OpacityMask>

            <Grid>
                <Image
                    x:Name="WindowBackgroundImage"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Opacity="0.35"
                    Stretch="UniformToFill" />
                <Rectangle Fill="#D9101010" />
            </Grid>
        </winui:OpacityMaskView>

        <!--  ================= ЛЕВАЯ ПОЛОВИНА: обложка + управление =================  -->
        <Grid Grid.Column="0">

            <!--  Шапки нет: выход из режима — кнопка закрытия в панели управления (Esc)  -->
            <Grid Padding="48,28,40,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Центр: обложка + метаданные  -->
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        MaxWidth="420"
                        MaxHeight="420"
                        Margin="0,12,0,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="14">
                        <Grid>
                            <FontIcon
                                FontSize="64"
                                Glyph="&#xEC4F;"
                                Opacity="0.4" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Spacing="6">
                        <!--  Название трека: крупный полужирный VKSans (как в мини-плеере)  -->
                        <TextBlock
                            x:Name="TrackTitle"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Название трека"
                            FontFamily="{ThemeResource VKSansDemiBold}"
                            FontSize="30"
                            MaxLines="2"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <!--  Артист: обычный VKSans, приглушённый  -->
                        <TextBlock
                            x:Name="TrackArtist"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Исполнитель"
                            FontFamily="{ThemeResource VKSansRegular}"
                            FontSize="18"
                            Opacity="0.7"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!--  Управление  -->
                <fullscreen:FullScreenControls
                    x:Name="Controls"
                    Grid.Row="1"
                    VerticalAlignment="Bottom" />
            </Grid>
        </Grid>

        <!--  ================= ПРАВАЯ ПОЛОВИНА: текст / очередь =================  -->
        <!--
            Панель без собственного фона: фон даёт маскированное изображение обложки,
            которое плавно просвечивает сквозь неё (см. OpacityMaskView выше).
        -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Переключатель разделов + действия над текстом.
                Border (а не Grid) — у него есть Padding, который можно анимировать
                вместе с Height: при автоскрытии шапка плавно схлопывается в 0.
            -->
            <Border
                x:Name="RightPaneHeader"
                Grid.Row="0"
                Padding="32,20,32,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <viewsControls:ChoosenControl
                        x:Name="SectionsSwitcher"
                        Height="40"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Переключение разделов: текст песни или очередь">
                        <viewsControls:ChoosenControl.Buttons>
                            <Button Content="Текст песни" />
                            <Button Content="Очередь" />
                        </viewsControls:ChoosenControl.Buttons>
                    </viewsControls:ChoosenControl>

                    <!--  Действия над текстом: источник + настройки  -->
                    <StackPanel
                        x:Name="LyricsActionsPanel"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ComboBox
                            x:Name="SourceCombo"
                            MinWidth="120"
                            AutomationProperties.Name="Источник текста песни"
                            SelectionChanged="SourceCombo_SelectionChanged" />
                        <Button
                            x:Name="LyricsSettingsButton"
                            Width="40"
                            Height="33"
                            Padding="0"
                            AutomationProperties.Name="Настройки отображения текста"
                            Click="LyricsSettingsButton_Click"
                            ToolTipService.ToolTip="Настройки текста">
                            <FontIcon
                                FontFamily="{ThemeResource VKSansRegular}"
                                FontSize="16"
                                Glyph="T" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Сцена: текст песни и очередь меняют друг друга с анимацией  -->
            <Grid x:Name="StageGrid" Grid.Row="1">
                <!--  Текст песни: хост для существующего LyricsPage (репарент, без второго BetterLyric)  -->
                <Grid x:Name="LyricsSection">
                    <ContentControl
                        x:Name="LyricsHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent" />
                    <TextBlock
                        x:Name="LyricsPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource VKSansRegular}"
                        FontSize="20"
                        Opacity="0.5"
                        Text="Текст песни недоступен"
                        Visibility="Collapsed" />
                </Grid>

                <!--  Очередь треков  -->
                <Grid x:Name="QueueSection" Visibility="Collapsed">
                    <fullscreen:FullScreenQueuePane x:Name="QueuePane" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
