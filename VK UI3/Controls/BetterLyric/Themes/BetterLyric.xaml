<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VK_UI3.Controls.BetterLyric"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Style BasedOn="{StaticResource DefaultBetterLyricStyle}" TargetType="local:BetterLyric" />

    <Style x:Key="DefaultBetterLyricStyle" TargetType="local:BetterLyric">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:BetterLyric">
                    <Grid x:Name="PART_Root" Background="Transparent">
                        <!--
                            CanvasControl (НЕ CanvasAnimatedControl): его composition-поверхность
                            поддерживает альфа-канал, поэтому канвас действительно прозрачен и
                            фон контрола/окна под ним виден. Очистка задаётся ClearColor
                            (по умолчанию Transparent). Кадры двигает CompositionTarget.Rendering
                            (см. BetterLyric.RenderLoop.cs) с Invalidate().
                        -->
                        <!--
                            Канвас растягивается по Grid шаблона (Stretch): жёсткая привязка
                            Width/Height к TemplatedParent в WinUI нестабильна и приводила
                            к нулевому размеру канваса — Win2D не рисовал ни строки.
                        -->
                        <win2d:CanvasControl
                            x:Name="PART_Canvas"
                            ClearColor="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <!--  ScrollViewer лежит поверх канваса и не должен его перекрывать  -->
                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            Background="Transparent"
                            VerticalScrollBarVisibility="Hidden">
                            <Grid Background="Transparent" />
                        </ScrollViewer>

                        <!--
                            Подсказка «текст без синхронизации»: показывается, когда у песни
                            нет таймингов. Пользователю понятно, почему строки не подсвечиваются
                            и полотно не следует за плеером.
                        -->
                        <Border
                            x:Name="PART_UntimedBadge"
                            Margin="0,10,0,0"
                            Padding="10,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            AutomationProperties.HelpText="У этой песни нет таймингов текста: строки не подсвечиваются и не прокручиваются автоматически"
                            AutomationProperties.Name="Текст без синхронизации"
                            Background="#33000000"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="#CCFFFFFF"
                                    Glyph="&#xE9D9;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#CCFFFFFF"
                                    Text="Текст без синхронизации" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
